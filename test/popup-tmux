#!/bin/sh
# popup-tmux: a stub tmux for ftb-tmux-popup tests. display-message prints
# $POPUP_SCREEN (pane_top cursor_y pane_left cursor_x window_height
# window_width status status-position); popup writes its arguments, then the
# fzf command file it was given (-E ". FILE", the last argument), to $POPUP_LOG
case $1 in
  display-message) echo "$POPUP_SCREEN" ;;
  popup)
    shift
    echo "popup $*" >"$POPUP_LOG"
    for a; do last=$a; done
    cat "${last#. }" >>"$POPUP_LOG"
    ;;
esac
