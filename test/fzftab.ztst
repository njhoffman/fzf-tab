  local -a fzfargs=(${(Q)${(z)"$(<popup.log)"}})
  local preview=${${(M)fzfargs:#--preview=*}[1]#--preview=}
  # the preview command appears once, inside --preview=, never as an argument of its own
  local pcmd='print -r -- "word=$word realpath=$realpath"'
  (( ${fzfargs[(Ie)$pcmd]} )) && print preview-passed-as-argument
  (( ${fzfargs[(Ie)--no-preview]} )) && print no-preview-despite-fzf-preview
  # a row is colors, then the word and its suffix as NUL-separated fields
  grep -a 'dir1' popup.log.rows | head -1 > row
  preview=${preview//${TMPPREFIX:-\/tmp\/zsh}-fzf-tab-$USER/$PWD/popup.log.tmp}
  SHELL=zsh zsh -fc "${preview//\{f\}/$PWD/row}" 2>&1
  rm -rf popup-bin popup.log popup.log.rows popup.log.tmp row
