# Tests for fzf tab.

%prep
  unset -m LC_\*
  export LC_ALL=C
  ZSH_TEST_LANG=
  langs=(en_{US,GB}.{UTF-,utf}8 en.UTF-8
         $(locale -a 2>/dev/null | egrep 'utf8|UTF-8'))
  for LANG in $langs; do
    if [[ é = ? ]]; then
      ZSH_TEST_LANG=$LANG
      break;
    fi
  done
  if [[ $OSTYPE = cygwin ]]; then
    ZTST_unimplemented="the zsh/zpty module does not work on Cygwin"
  elif ( zmodload zsh/zpty 2>/dev/null ); then
    . $ZTST_srcdir/comptest
    mkdir comp.tmp
    cd comp.tmp
    comptestinit -z zsh &&
    {
      comptesteval 'compdef _tst tst'
      mkdir dir1 &&
      mkdir dir2 &&
      touch file1 &&
      touch file2
      touch dir1/file1
      git init
    }
  else
    ZTST_unimplemented="the zsh/zpty module is not available"
  fi

  comptesteval ". $ZTST_srcdir/../fzf-tab.zsh"
  comptesteval "zstyle ':fzf-tab:*' debug-command $ZTST_srcdir/select -n 1 -h '\$#_ftb_headers' -q '\"\$_ftb_query\"'"
  comptesteval '
  zstyle ":fzf-tab:*" default-color "<LC><C0><RC>"
  zstyle ":fzf-tab:*" single-group color header
  zstyle ":fzf-tab:*" group-colors "<LC><C1><RC>" "<LC><C2><RC>" "<LC><C3><RC>" "<LC><C4><RC>"
  fzf-tab-complete-with-report() {
    print -lr "<WIDGET><fzf-tab-complete>"
    zle fzf-tab-complete 2>&1
    print -lr - "<LBUFFER>$LBUFFER</LBUFFER>" "<RBUFFER>$RBUFFER</RBUFFER>"
    zle clear-screen
    zle -R
  }
  zle -N fzf-tab-complete-with-report
  bindkey "^I" fzf-tab-complete-with-report
  '

%test

  comptest $': \t'
0:directories and files
>line: {: dir1/}{}
>QUERY:{}
>DESCRIPTION:{file}
>C1:{dir1/}
>C1:{dir2/}
>C1:{file1}
>C1:{file2}

  comptest $': d\t'
0:unambiguous prefix
>line: {: dir}{}

  comptesteval '_tst() { compadd ".#abc" ".#def" ".#hij" }'
  comptest $'tst ".#"\t'
0:unambiguous prefix in quote string
>line: {tst ".#abc }{"}
>QUERY:{.#}
>C0:{.#abc}
>C0:{.#def}
>C0:{.#hij}

  comptesteval '_tst() { compadd /home /usr /lib; compstate[insert]=menu }'
  comptest $'tst \t'
0:force list
>line: {tst /home }{}
>QUERY:{/}
>C0:{/home}
>C0:{/lib}
>C0:{/usr}

  comptesteval 'zstyle ":completion:*" menu true'
  comptest $': d\t'
0:prefix
>line: {: dir1/}{}
>QUERY:{dir}
>DESCRIPTION:{file}
>C1:{dir1/}
>C1:{dir2/}

  comptesteval '_tst () { compadd d c b a }'
  comptest $'tst \t'
0:normal
>line: {tst a }{}
>QUERY:{}
>C0:{a}
>C0:{b}
>C0:{c}
>C0:{d}

  comptesteval 'zstyle ":completion:*:tst:*" sort false'
  comptest $'tst \t'
0:no sort
>line: {tst d }{}
>QUERY:{}
>C0:{d}
>C0:{c}
>C0:{b}
>C0:{a}

  comptesteval 'zstyle ":fzf-tab:*:tst:*" fzf-flags -n 1,2'
  comptest $'tst \t'
  comptesteval 'zstyle -d ":fzf-tab:*:tst:*" fzf-flags'
0:multi select
>line: {tst c d }{}
>QUERY:{}
>C0:{d}
>C0:{c}
>C0:{b}
>C0:{a}

  comptest $': *\t'
0:expand
>line: {: dir1 dir2 file1 file2 }{}

  comptesteval 'zstyle ":completion:*:warnings" format "<WARN>%d</WARN>"'
  comptest $': asd\t'
0:warnings
>line: {: asd}{}
>WARN:{`file'}

# enclose ' for syntax highlight

  comptesteval "touch 'abc def'"
  comptest $': ./a\t'
0:filename with space
>line: {: ./abc\ def }{}

  comptest $': ./abdef\C-b\C-b\C-b\t'
0:complete in word
>line: {: ./abc\ def }{}

  comptest $': ./abc def\C-b\C-b\C-b\C-b\t'
  comptesteval "rm 'abc def'"
0:complete in word(with known bug)
>line: {: ./abc\ def}{ def}

  comptesteval 'mkdir -p abc/def/hij abc/dfe/hij'
  comptest $': ./a/d/h\t'
  comptesteval 'rm -rd abc'
0:nested directory
>line: {: ./abc/def/h}{}
>QUERY:{d}
>DESCRIPTION:{file}
>C1:{def/}
>C1:{dfe/}

  comptesteval '_tst() { a=(a); _describe "group1" a; a=(b); _describe "group2" a }'
  comptest $'tst \t'
0:multi headers
>line: {tst a }{}
>QUERY:{}
>DESCRIPTION:{group1}
>DESCRIPTION:{group2}
>C1:{·a}
>C2:{·b}

  comptest $'git add dir1\t'
0:add empty word
>line: {git add dir1/}{}

  comptesteval "zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'"
  comptesteval "touch vim.coc"
  comptest $': coc\t'
  comptesteval "rm vim.coc; zstyle -d ':completion:*' matcher-list"
0:matcher-list
>line: {: vim.coc }{}

  comptesteval $'cd dir1'
  comptest $': ../d\t'
  comptesteval $'cd ..'
0:IPREFIX
>line: {: ../dir1/}{}
>QUERY:{dir}
>DESCRIPTION:{file}
>C1:{dir1/}
>C1:{dir2/}

  comptest $': $PWD/d\t'
0:expansion
>line: {: $PWD/dir1/}{}
>QUERY:{dir}
>DESCRIPTION:{file}
>C1:{dir1/}
>C1:{dir2/}

  comptesteval 'echo no > called'
  comptesteval "touch 'dir\`echo yes > called\`'"
  comptest $': d\t'
  echo called:$(<called)
  comptesteval "rm 'dir\`echo yes > called\`' called"
0:don''t expand file name
>line: {: dir1/}{}
>QUERY:{dir}
>DESCRIPTION:{file}
>C1:{dir1/}
>C1:{dir2/}
>C1:{dir`echo yes > called`}
>called:no

  comptesteval "zstyle ':fzf-tab:*' debug-command true"
  comptest $': d\t'
  comptesteval "zstyle ':fzf-tab:*' debug-command $ZTST_srcdir/select -n 1 -h '\$#headers' -q '\"\$query\"'"
0:cancel completion
>line: {: d}{}

  comptesteval "zstyle ':fzf-tab:*' debug-command $ZTST_srcdir/select -n QUERY -h '\$#headers' -q '\"dragon\"'"
  comptest $': ./d\t'
  comptesteval "zstyle ':fzf-tab:*' debug-command $ZTST_srcdir/select -n 1 -h '\$#headers' -q '\"\$query\"'"
0:use query directly
>line: {: ./dragon}{}
>QUERY:{dragon}
>DESCRIPTION:{file}
>C1:{dir1/}
>C1:{dir2/}

  comptesteval 'zstyle ":completion:*" menu false'
  comptesteval "local prefix_1=1 prefix_2=1 prenofix_3=1"
  comptest $'echo $pre\t'
  comptesteval 'zstyle ":completion:*" menu true'
0:parameter completion
>line: {echo $pre}{}
>QUERY:{}
>DESCRIPTION:{parameter}
>C1:{prefix_1}
>C1:{prefix_2}
>C1:{prenofix_3}

  comptesteval '_tst() { compadd -J packages -X package openpgp-keys-gentoo-release -MERGING-pnpm-bin }'
  comptest $'tst \t'
0:completions starts with dash
>line: {tst }{}
>QUERY:{}
>C1:{package }
>C1:{openpgp-keys-gentoo-release}
>C1:{-MERGING-pnpm-bin}

  rm -f $ZTST_srcdir/once.state
  comptesteval '_tst() { if (( CURRENT == 2 )); then compadd alpha beta; else compadd xray yankee; fi }'
  comptesteval "zstyle ':fzf-tab:*' continuous-trigger / ' '"
  comptesteval "zstyle ':fzf-tab:*' debug-command $ZTST_srcdir/select-once $ZTST_srcdir/once.state ' ' -n 1 -h '\$#_ftb_headers' -q '\"\$_ftb_query\"'"
  comptest $'tst \t'
0:space continues with the next argument
>line: {tst }{}
>QUERY:{}
>C0:{alpha}
>C0:{beta}
>line: {tst alpha xray }{}
>QUERY:{}
>C0:{xray}
>C0:{yankee}

  rm -f $ZTST_srcdir/once.state
  comptest $': \t'
0:space after a directory moves on to the next argument
>line: {: }{}
>QUERY:{}
>DESCRIPTION:{file}
>C1:{dir1/}
>C1:{dir2/}
>C1:{file1}
>C1:{file2}
>line: {: dir1/ dir1/}{}
>QUERY:{}
>DESCRIPTION:{file}
>C1:{dir1/}
>C1:{dir2/}
>C1:{file1}
>C1:{file2}

  rm -f $ZTST_srcdir/once.state
  comptesteval '_tst() { if (( CURRENT == 2 )); then compadd alpha beta; else compadd only; fi }'
  comptest $'tst \t'
  comptesteval "zstyle ':fzf-tab:*' debug-command $ZTST_srcdir/select -n 1 -h '\$#_ftb_headers' -q '\"\$_ftb_query\"'"
  comptesteval "zstyle -d ':fzf-tab:*' continuous-trigger"
  rm -f $ZTST_srcdir/once.state
0:after a space, a lone next candidate is left alone
>line: {tst }{}
>QUERY:{}
>C0:{alpha}
>C0:{beta}
>line: {tst alpha }{}

  rm -f $ZTST_srcdir/date.called
  date() { print -r called >> $ZTST_srcdir/date.called }
  source $ZTST_srcdir/../util.zsh
  __util_log message >/dev/null
  unfunction date
  [[ ! -e $ZTST_srcdir/date.called ]]
0:util.zsh (sourced at every shell start) runs no date


  mkdir -p popup-bin
  ln -sf $ZTST_srcdir/popup-tmux popup-bin/tmux
  fpath=($ZTST_srcdir/../lib $fpath)
  autoload -Uz ftb-tmux-popup
  (
    export POPUP_LOG=$PWD/popup.log POPUP_SCREEN='0 10 0 5 40 120 on bottom' TMUX_PANE=%1 PATH=$PWD/popup-bin:$PATH
    zstyle ':fzf-tab:*' popup-border-style double
    zstyle ':fzf-tab:*' popup-border-color fg=red
    zstyle ':fzf-tab:*' popup-max-width 12
    zstyle ':fzf-tab:*' popup-max-height 3
    print -l ${(l:30::x:)} a b c d e f g h | ftb-tmux-popup >/dev/null 2>&1
  )
  print -r -- ${${(f)"$(<popup.log)"}[1]%% -d *}
  [[ $(<popup.log) == *--layout=reverse* ]] && print below
0:popup: border style and color, maximum width and height
>popup -x 5 -y 18 -b double -S fg=red -w 12 -h 7
>below

  (
    export POPUP_LOG=$PWD/popup.log POPUP_SCREEN='0 30 0 5 40 120 on bottom' TMUX_PANE=%1 PATH=$PWD/popup-bin:$PATH
    export FZF_DEFAULT_OPTS=--cycle
    zstyle ':fzf-tab:*' popup-smart-tab-bindings 'tab:toggle+up' 'btab:toggle+down'
    zstyle ':fzf-tab:*' use-fzf-default-opts yes
    local fzf_tmux_width_factor=4
    print -l abc de | ftb-tmux-popup >/dev/null 2>&1
  )
  print -r -- ${${(f)"$(<popup.log)"}[1]%% -d *}
  local log=$(<popup.log)
  [[ $log == *--layout=default* ]] && print above
  [[ $log == *--bind=tab:toggle+up,btab:toggle+down* ]] && print smart-tab
  [[ $log == *"FZF_DEFAULT_OPTS='--cycle'"* ]] && print default-opts
0:popup: smart-tab bindings above the cursor, width factor, FZF_DEFAULT_OPTS
>popup -x 5 -y 30 -b rounded -S fg=black -w 7 -h 6
>above
>smart-tab
>default-opts


  comptesteval "export POPUP_LOG=$PWD/popup.log POPUP_SCREEN='0 10 0 5 40 120 on bottom' TMUX_PANE=%1 PATH=$PWD/popup-bin:\$PATH"
  comptesteval "zstyle -d ':fzf-tab:*' debug-command; zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup; zstyle ':fzf-tab:*' popup-border-style double"
  comptesteval '_tst() { compadd alpha beta }'
  comptest $'tst \t'
  comptesteval "zstyle -d ':fzf-tab:*' fzf-command; zstyle -d ':fzf-tab:*' popup-border-style; unset TMUX_PANE"
  comptesteval "zstyle ':fzf-tab:*' debug-command $ZTST_srcdir/select -n 1 -h '\$#_ftb_headers' -q '\"\$_ftb_query\"'"
  print -r -- ${${(f)"$(<popup.log)"}[1]%% -w *}
  rm -rf popup-bin popup.log
0:popup from a completion: runs in the completing shell, so its zstyles apply
>line: {tst }{}
>popup -x 5 -y 17 -b double -S fg=black


  comptesteval $'_tst() { local -a d=(\'alpha one\' \'beta two\'); compadd -Q -d d -- \'alpha\\\\ one\' \'beta\\\\ two\' }'
  comptest $'tst \t'
0:pre-quoted -Q words with a doubled backslash (carapace) are inserted with one
>line: {tst alpha\ one }{}
>QUERY:{}
>C0:{alpha one}
>C0:{beta two}

%clean

  zmodload -ui zsh/zpty

