#!/usr/bin/env zsh

# Show results with tmux popup
# Example usage:
#   zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup
#   zstyle ':fzf-tab:*' popup-pad 0 0
#   ls | ftb-tmux-popup (standalone usage)

FZF_TAB_HOME="${FZF_TAB_HOME:-${0:A:h}/..}"

emulate -L zsh -o extended_glob
zmodload zsh/mapfile

# import math functions (only if they're not already defined)
if (( ! $+functions[zsh_math_func_min] )); then
  autoload -Uz zmathfunc
  zmathfunc
fi

# fzf-tab's directory (-ftb-fzf's tmp_dir), or the same one found here when
# the popup runs on its own
if [[ -z $tmp_dir ]]; then
  # autoloaded with fzf-tab; on its own the popup is found in the same fpath directory
  (( $+functions[-ftb-tmp-dir] )) || autoload -Uz -- -ftb-tmp-dir
  local REPLY
  -ftb-tmp-dir || return 1
  local tmp_dir=$REPLY
fi

# fallback to fzf if it is not running in tmux
if (( ! $+TMUX_PANE )); then
  ftb-fzf $@
  return
fi

local ret=0

if (( ! $+commands[fzf] )); then
  print -ru2 -- "[fzf-tab] fzf not found on PATH"
  return 127
fi

local -a fzf_opts=($@)
fzf_opts=(${${fzf_opts/--height*}/--layout*})
fzf_opts+=(
  '--ansi' 
  "--delimiter='\x00'" 
  '--multi' 
  '--nth=2' 
  '--print-query' 
  '--tiebreak=begin'
)


# get position of cursor and size of window
local -a tmp=($(command tmux display-message -p "#{pane_top} #{cursor_y} #{pane_left} #{cursor_x} #{window_height} #{window_width} #{status} #{status-position}"))
local cursor_y=$((tmp[1] + tmp[2])) cursor_x=$((tmp[3] + tmp[4])) window_height=$tmp[5] window_width=$tmp[6] window_top=0

# a status bar on top pushes the panes down by its lines: #{status} is "on"
# for one line, a number for two to five, "off" for none
if [[ $tmp[8] == 'top' ]]; then
  case $tmp[7] in
    on) window_top=1 ;;
    <->) window_top=$tmp[7] ;;
  esac
  cursor_y=$((cursor_y + window_top))
fi

# if not called by fzf-tab
if (( ! $+IN_FZF_TAB )); then
  cat > $tmp_dir/completions.$$
fi

local text REPLY comp_lines comp_length length popup_pad popup_min_size popup_max_width popup_max_height smart_tab_bindings fzf_tmux_width_factor
zstyle -a ":fzf-tab:$_ftb_curcontext" popup-border-style popup_border_style || popup_border_style="rounded"
zstyle -a ":fzf-tab:$_ftb_curcontext" popup-border-color popup_border_color || popup_border_color="fg=black"
zstyle -a ":fzf-tab:$_ftb_curcontext" popup-pad popup_pad || popup_pad=(0 0)
zstyle -a ":fzf-tab:$_ftb_curcontext" popup-min-size popup_min_size || popup_min_size=(0 0)
zstyle -s ":fzf-tab:$_ftb_curcontext" popup-max-height popup_max_height || popup_max_height=$window_height
zstyle -s ":fzf-tab:$_ftb_curcontext" popup-max-width popup_max_width || popup_max_width=$window_width
zstyle -a ":fzf-tab:$_ftb_curcontext" popup-smart-tab-bindings smart_tab_bindings || smart_tab_bindings=(tab:up btab:down)
zstyle -b ":fzf-tab:$_ftb_curcontext" use-fzf-default-opts use_fzf_default_opts || use_fzf_default_opts="no"
zstyle -s ":fzf-tab:$_ftb_curcontext" fzf-tmux-width-factor fzf_tmux_width_factor || fzf_tmux_width_factor=5

# get the size of content, note we should remove all ANSI color code
comp_lines=$(( ${#${(f)mapfile[$tmp_dir/completions.$$]}} + $popup_pad[2] ))
if (( comp_lines <= 500 )); then
  comp_length=0
  for line in ${(f)mapfile[$tmp_dir/completions.$$]}; do
    length=${(m)#${(S)line//$'\x1b['[0-9]#*m}}
    (( length >= comp_length )) && comp_length=$length
  done
else
  # FIXME: can't get the correct width of CJK characters.
  comp_length=$( command perl -ne 's/\x1b\[[0-9;]*m//g;s/\x00//g; $m= length() if $m < length(); END { print $m }' < $tmp_dir/completions.$$ )
fi
comp_length=$(( comp_length + $popup_pad[1] ))

local popup_height popup_y popup_width popup_x adjust_height

# adjust the popup height if the fzf finder info style is not default
if (( $fzf_opts[(I)--info=*(hidden|inline)*] > 0 && $fzf_opts[(I)--style=*(minimal|full)*] > 0 )); then
    adjust_height=-1
fi

# calculate the popup height and y position
if (( cursor_y * 2 > window_height )); then
  # show above the cursor
  popup_height=$(( min(max(min(comp_lines, popup_max_height) + 4, popup_min_size[2]), cursor_y - window_top) + adjust_height ))
  popup_y=$cursor_y
  if zstyle -T ":fzf-tab:$_ftb_curcontext" popup-smart-tab; then
    fzf_opts+=(--bind=${(j:,:)smart_tab_bindings})
  fi
  fzf_opts+=(--layout=default)
else
  # show below the cursor
  popup_height=$(( min(max(min(comp_lines, popup_max_height) + 4, popup_min_size[2]), window_height - cursor_y + window_top - 1) + adjust_height ))
  popup_y=$(( cursor_y + popup_height + 1 ))
  fzf_opts+=(--layout=reverse)
fi

# calculate the popup width and x position
popup_width=$(( min(min(max(comp_length + fzf_tmux_width_factor, popup_min_size[1]), window_width), popup_max_width) ))
popup_x=$(( cursor_x + popup_width > window_width ? window_width - popup_width : cursor_x ))

# fzf's defaults (variable and file) only with use-fzf-default-opts; see -ftb-fzf
local fzf_default_opts='' fzf_default_opts_file=''
if [[ "$use_fzf_default_opts" == "yes" ]]; then
  fzf_default_opts=$FZF_DEFAULT_OPTS
  fzf_default_opts_file=${FZF_DEFAULT_OPTS_FILE-}
fi
# fzf inside the popup must not open a popup of its own (upstream #587): turn
# off a --tmux/--popup from the defaults. Only when they have one, which also
# means this fzf knows the option ($(<file) reads without a fork).
if [[ "$fzf_default_opts ${fzf_default_opts_file:+$(<$fzf_default_opts_file)}" == *--(tmux|popup)* ]]; then
  fzf_opts+=(--no-tmux)
fi
echo -E "env FZF_DEFAULT_OPTS=${(qq)fzf_default_opts} FZF_DEFAULT_OPTS_FILE=${(qq)fzf_default_opts_file} SHELL=$ZSH_NAME \
  $commands[fzf] ${(qq)fzf_opts[@]} \
  < $tmp_dir/completions.$$ > $tmp_dir/result-$$" > $tmp_dir/fzf-$$
{
  tmux popup -x $popup_x -y $popup_y \
       -b $popup_border_style \
       -S $popup_border_color \
       -w $popup_width -h $popup_height \
       -d $PWD -E ". $tmp_dir/fzf-$$" || ret=$?
  echo -E "$(<$tmp_dir/result-$$)"
} always {
  command rm $tmp_dir/*-$$
  (( $+IN_FZF_TAB )) || command rm $tmp_dir/completions.$$
}

return $ret
